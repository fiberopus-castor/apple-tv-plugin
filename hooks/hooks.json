{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__appletv-dg__appletv_dg_launch_app",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/mom-safety-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__appletv-dg__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/heartbeat-alert-check.sh"
          }
        ]
      }
    ]
  }
}
